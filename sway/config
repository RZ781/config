#for_window [title=""] opacity 0.95
default_border normal
for_window [title="Chromium"] border none
default_floating_border normal
font monospace 10
force_display_urgency_hint 500 ms
titlebar_border_thickness 1
titlebar_padding 4
gaps inner 10
hide_edge_borders none

include /etc/sway/config.d/*

exec pipewire
exec gammastep -O 5000
exec corewatch

assign [app_id="chromium"] 1
for_window [app_id="chromium"] focus
assign [app_id="foot"] 2
for_window [app_id="foot"] focus
